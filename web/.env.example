# Turso database — make a free DB at turso.tech, then `turso db tokens create`
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=

# NextAuth — generate with `openssl rand -base64 32`
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Google OAuth — https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Email digest fallback (optional) — https://resend.com
RESEND_API_KEY=
DIGEST_FROM_EMAIL=jobs@yourdomain.dev

# Vercel cron auth — bearer token Vercel sends with cron pings
CRON_SECRET=
